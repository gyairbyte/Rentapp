# Supabase project credentials (public, safe to embed)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL used for Supabase auth redirects. Set to localhost for local dev.
# Vercel automatically provides NEXT_PUBLIC_VERCEL_URL for preview and prod,
# so this value is mainly for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key is only used for one-off admin/migration scripts and
# should never be exposed in the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_migrations_only
